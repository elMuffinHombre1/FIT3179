      "labelPadding": 6,
      "grid": true,
      "gridDash": [
       2,
       3
      ]
     }
    },
    "x": {
     "field": "signed",
     "type": "quantitative",
     "title": "← Males  |  Females →  (spending, $ million)",
     "scale": {
      "domain": [
       -1250,
       950
      ]
     },
     "axis": {
      "labelExpr": "'$' + abs(datum.value) + 'm'",
      "grid": true,
      "values": [
       -1000,
       -500,
       0,
       500
      ]
     }
    },
    "color": {
     "field": "series",
