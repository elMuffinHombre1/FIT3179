{
 "description": "Butterfly chart of 2023-24 health spending linked to overweight and obesity by age group, males on the left and females on the right, split into direct treatment and treatment of resulting conditions.",
 "title": {
  "text": [
   "Health spending on excess weight peaks at ages 65–69"
  ],
  "subtitle": [
   "2023–24, in millions of dollars by age group and",
   "sex. Darker = treating conditions caused by excess weight,",
   "lighter = direct obesity treatment."
  ]
 },
 "width": 760,
 "height": 540,
 "layer": [
  {
   "data": {
    "url": "11_cost_butterfly.csv",
    "format": {
     "type": "csv"
    }
   },
   "transform": [
    {
     "calculate": "datum.sex == 'Males' ? -datum.aud_m : datum.aud_m",
     "as": "signed"
    },
    {
     "calculate": "datum.sex + ' – ' + (datum.type == 'Treatment & management of obesity' ? 'direct obesity treatment' : 'conditions caused by excess weight')",
     "as": "series"
    },
    {
     "calculate": "datum.type == 'Treatment & management of obesity' ? 1 : 0",
     "as": "ord"
    }
   ],
   "mark": {
    "type": "bar",
    "tooltip": true
   },
   "encoding": {
    "y": {
     "field": "age",
     "type": "ordinal",
     "sort": [
      "85+",
      "80–84",
      "75–79",
      "70–74",
      "65–69",
      "60–64",
      "55–59",
      "50–54",
