{
 "description": "Heatmap of obesity prevalence for adults 18-64 by household type, employment, marital status and household tenure across four survey years.",
 "title": {
  "text": [
   "Household circumstances matter less: differences of 2 to 6",
   "points"
  ],
  "subtitle": [
   "Age-standardised percentage of adults 18–64 who are obese, by",
   "survey year. Darker = higher."
  ]
 },
 "data": {
  "url": "08_household_heatmap.csv",
  "format": {
   "type": "csv"
  }
 },
 "facet": {
  "row": {
   "field": "group",
   "type": "nominal",
   "title": null,
   "sort": [
    "Employment",
    "Household type",
    "Marital status",
    "Household tenure"
   ],
   "header": {
    "labelAngle": 0,
    "labelAlign": "left",
    "labelFontWeight": "bold",
    "labelLimit": 170,
    "labelPadding": 6
   }
  }
 },
 "spec": {
  "width": 613,
  "height": {
   "step": 32
  },
  "encoding": {
   "y": {
    "field": "category",
    "type": "nominal",
    "sort": null,
    "title": null,
    "axis": {
     "labelLimit": 220,
     "domain": false,
     "ticks": false,
     "grid": false
    }
   },
   "x": {
    "field": "year",
    "type": "ordinal",
    "title": "Survey year",
    "axis": {
     "orient": "top",
     "labelAngle": 0,
     "domain": false,
     "ticks": false,
     "grid": false
    }
   }
  },
  "layer": [
   {
    "mark": {
     "type": "rect",
     "stroke": "#fff",
     "strokeWidth": 2,
     "tooltip": true
    },
    "encoding": {
     "color": {
      "field": "asr",
      "type": "quantitative",
      "title": "Adults who are obese (%)",
      "scale": {
       "domain": [
        16.0,
        20.8,
        25.6,
        30.4,
        35.2,
        40.0
       ],
       "range": [
        "#E3EEF8",
        "#B7D3EA",
        "#7FB1D8",
        "#4A8CC2",
        "#1C63A0",
        "#0B3560"
       ],
       "clamp": true
      },
      "legend": {
       "orient": "bottom",
       "gradientLength": 320,
       "labelExpr": "datum.value + '%'"
      }
     },
     "tooltip": [
      {
       "field": "group",
       "title": "Factor"
      },
      {
       "field": "category",
       "title": "Group"
      },
      {
       "field": "year",
       "title": "Survey year"
      },
      {
       "field": "asr",
       "title": "Age-std obesity (%)"
      },
      {
       "field": "lo",
       "title": "CI low (%)"
      },
      {
       "field": "hi",
       "title": "CI high (%)"
      }
     ]
    }
   },
   {
    "transform": [
     {
      "calculate": "format(datum.asr,'.1f') + '%'",
      "as": "lab"
     }
    ],
    "mark": {
     "type": "text",
     "fontSize": 14
    },
    "encoding": {
     "text": {
      "field": "lab"
     },
     "color": {
      "condition": {
       "test": "datum.asr > 30",
       "value": "white"
      },
      "value": "#0F172A"
     }
    }
   }
  ]
 },
 "resolve": {
  "scale": {
   "y": "independent"
  }
 },
