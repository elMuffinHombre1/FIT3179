{
 "description": "Slope chart of obesity prevalence for five education levels in 2007-08 and 2017-18, adults 18-64.",
 "title": {
  "text": [
   "Obesity rose at every education level, and the gap",
   "widened"
  ],
  "subtitle": [
   "Age-standardised percentage obese, adults 18–64. Numbers in brackets are",
   "changes in percentage points. Wine = highest in 2017–18,",
   "teal = lowest."
  ]
 },
 "data": {
  "url": "06_education_slope.csv",
  "format": {
   "type": "csv"
  }
 },
 "width": 540,
 "height": 470,
 "encoding": {
  "x": {
   "field": "x",
   "type": "quantitative",
   "scale": {
    "domain": [
     -1.75,
     3.5
    ]
   },
   "axis": {
    "orient": "top",
    "values": [
     0,
     1
    ],
    "labelExpr": "datum.value == 0 ? '2007–08' : '2017–18'",
    "labelFontWeight": "bold",
    "labelFontSize": 13,
    "domain": false,
    "ticks": false,
    "grid": false,
    "title": null,
    "labelPadding": 8
   }
  },
  "y": {
   "field": "asr",
   "type": "quantitative",
   "title": "Adults who are obese (%)",
   "scale": {
    "domain": [
     0,
     45
    ],
    "zero": true
   },
   "axis": {
    "labelExpr": "datum.value + '%'",
    "values": [
     0,
     10,
     20,
     30,
     40
    ],
    "grid": true
   }
  },
  "color": {
   "field": "role",
   "type": "nominal",
   "title": null,
   "scale": {
    "domain": [
     "Highest",
     "Other",
     "Lowest"
    ],
    "range": [
     "#882255",
     "#9A9A9A",
     "#44AA99"
    ]
   },
   "legend": null
  }
 },
 "layer": [
  {
   "mark": {
    "type": "line",
    "strokeWidth": 3
   },
