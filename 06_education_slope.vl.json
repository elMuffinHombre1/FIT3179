     {
      "field": "name",
      "title": "Education"
     },
     {
      "field": "year",
      "title": "Survey year"
     },
     {
      "field": "asr",
      "title": "Age-std obesity (%)"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.x == 0"
    }
   ],
   "mark": {
    "type": "text",
    "align": "right",
    "dx": -12,
    "fontSize": 11.5
   },
   "encoding": {
    "y": {
     "field": "y_label",
     "type": "quantitative"
    },
    "text": {
     "field": "label"
    },
    "color": {
