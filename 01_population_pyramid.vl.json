{
 "description": "Population pyramid of the share of boys and girls by age band, and of adult men and women, who are overweight but not obese or obese. Males on the left, females on the right.",
 "title": {
  "text": [
   "The share overweight or obese climbs from childhood into",
   "adulthood"
  ],
  "subtitle": [
   "Percentage of each group, males left and females right.",
   "Dark = obese, light = overweight but not obese.",
   "Labels show the total. Adults and children use different",
   "BMI definitions."
  ]
 },
 "data": {
  "url": "01_population_pyramid.csv",
  "format": {
   "type": "csv"
  }
 },
 "facet": {
  "row": {
   "field": "band",
   "type": "nominal",
   "sort": [
    "Adults",
    "Children"
   ],
   "title": null,
   "header": {
    "labelAngle": 0,
    "labelAlign": "left",
    "labelAnchor": "start",
    "labelFontWeight": "bold",
    "labelFontSize": 13,
    "labelOrient": "top",
    "labelPadding": 4
   }
  }
 },
 "spec": {
  "width": 766,
  "height": {
   "step": 38
  },
  "layer": [
   {
    "transform": [
     {
      "calculate": "datum.sex == 'Males' ? -datum.pct : datum.pct",
      "as": "signed"
     },
     {
      "calculate": "datum.sex + ' – ' + (datum.measure == 'Obese' ? 'obese' : 'overweight but not obese')",
      "as": "series"
     },
     {
      "calculate": "datum.measure == 'Obese' ? 0 : 1",
      "as": "ord"
     }
    ],
    "mark": {
     "type": "bar",
     "tooltip": true,
     "stroke": "#fff",
     "strokeWidth": 0.8
    },
    "encoding": {
     "y": {
      "field": "age",
      "type": "ordinal",
      "sort": [
       "Adults 18+",
       "16–17",
       "12–15",
       "8–11",
       "5–7",
       "2–4"
      ],
      "title": null,
      "axis": {
       "labelFontWeight": "bold"
      }
     },
     "x": {
      "field": "signed",
      "type": "quantitative",
      "title": "← Males  |  Females →  (% of group)",
      "scale": {
       "domain": [
        -90,
        90
       ]
      },
      "axis": {
       "labelExpr": "abs(datum.value) + '%'",
       "grid": true,
       "values": [
        -80,
        -60,
        -40,
        -20,
        0,
        20,
        40,
        60,
        80
       ]
      }
     },
     "color": {
      "field": "series",
      "type": "nominal",
      "title": null,
      "scale": {
       "domain": [
        "Males – obese",
        "Males – overweight but not obese",
        "Females – obese",
        "Females – overweight but not obese"
       ],
       "range": [
        "#0072B2",
        "#8CC3E6",
        "#D55E00",
        "#F2B07F"
       ]
      },
      "legend": {
       "orient": "bottom",
       "columns": 2,
       "labelLimit": 320
      }
     },
     "order": {
      "field": "ord",
      "type": "quantitative"
     },
     "tooltip": [
      {
       "field": "age",
       "title": "Group"
      },
      {
       "field": "series",
       "title": "Series"
      },
      {
       "field": "pct",
       "title": "% of group",
       "format": ".1f"
      }
     ]
    }
   },
   {
    "transform": [
     {
      "aggregate": [
       {
        "op": "sum",
        "field": "pct",
        "as": "total"
       }
      ],
      "groupby": [
       "age",
       "sex",
       "band"
      ]
     },
     {
      "calculate": "datum.sex == 'Males' ? -datum.total : datum.total",
      "as": "signed"
     },
     {
      "calculate": "format(datum.total, '.0f') + '%'",
      "as": "label"
     },
     {
      "filter": "datum.sex == 'Males'"
     }
    ],
    "mark": {
     "type": "text",
     "fontWeight": "bold",
     "fontSize": 13,
     "align": "right",
     "dx": -6,
     "baseline": "middle"
    },
    "encoding": {
     "y": {
      "field": "age",
      "type": "ordinal",
      "sort": [
       "Adults 18+",
       "16–17",
       "12–15",
       "8–11",
       "5–7",
       "2–4"
      ]
     },
     "x": {
      "field": "signed",
      "type": "quantitative"
     },
     "text": {
      "field": "label"
     }
    }
   },
   {
    "transform": [
     {
      "aggregate": [
       {
        "op": "sum",
        "field": "pct",
        "as": "total"
       }
      ],
      "groupby": [
       "age",
       "sex",
       "band"
      ]
     },
     {
      "calculate": "datum.sex == 'Males' ? -datum.total : datum.total",
      "as": "signed"
     },
     {
      "calculate": "format(datum.total, '.0f') + '%'",
      "as": "label"
     },
     {
      "filter": "datum.sex == 'Females'"
     }
    ],
    "mark": {
     "type": "text",
     "fontWeight": "bold",
     "fontSize": 13,
     "align": "left",
     "dx": 6,
     "baseline": "middle"
    },
    "encoding": {
     "y": {
      "field": "age",
      "type": "ordinal",
      "sort": [
       "Adults 18+",
       "16–17",
       "12–15",
       "8–11",
       "5–7",
       "2–4"
      ]
     },
     "x": {
      "field": "signed",
      "type": "quantitative"
     },
     "text": {
      "field": "label"
     }
    }
   }
  ]
 },
 "resolve": {
  "scale": {
   "y": "independent"
  }
 },
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "background": "#ffffff",
  "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "titleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "labelColor": "#334155",
   "titleColor": "#0F172A",
   "domainColor": "#94A3B8",
   "tickColor": "#94A3B8",
   "gridColor": "#E2E8F0",
   "titlePadding": 10,
   "labelPadding": 6
  },
  "axisX": {
   "grid": true
  },
  "axisY": {
   "grid": true
  },
  "legend": {
   "labelFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "titleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "labelColor": "#334155",
   "titleColor": "#0F172A",
   "titleLimit": 420,
   "symbolSize": 110
  },
  "header": {
   "labelFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "titleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "labelColor": "#0F172A",
   "titleColor": "#0F172A",
   "labelFontWeight": 600
  },
  "title": {
   "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "subtitleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "fontSize": 16,
   "fontWeight": 700,
   "anchor": "start",
   "color": "#0F172A",
   "subtitleColor": "#64748B",
   "subtitleFontSize": 12,
   "subtitlePadding": 6
  },
  "text": {
   "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "color": "#0F172A"
  },
  "mark": {
   "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif"
  }
 }
}