      "field": "Name",
      "title": "PHA"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_asr",
      "title": "Rate per 100"
     },
     {
      "field": "obese_n",
      "title": "Estimated obese adults",
      "format": ","
     }
    ]
   }
  },
  {
   "width": 240,
   "height": {
