{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFontSize": 11,
   "titleFontSize": 12
  },
  "title": {
   "fontSize": 15,
   "anchor": "start"
  }
 },
 "title": "Share of each diagnosis's hospital separations that carry an obesity (U78.1) code",
 "data": {
  "url": "7_hospitalisations.csv",
  "format": {
   "type": "csv"
  }
 },
 "vconcat": [
  {
   "width": 480,
   "height": {
    "step": 20
   },
   "mark": {
    "type": "bar",
    "color": "#1d7874",
    "tooltip": true
   },
   "encoding": {
    "y": {
     "field": "diagnosis",
     "type": "nominal",
     "sort": "-x",
     "title": null,
     "axis": {
      "labelLimit": 340
     }
    },
    "x": {
     "field": "pct_with_obesity",
     "type": "quantitative",
     "title": "% of diagnosis separations with obesity coded"
    },
    "tooltip": [
     {
      "field": "diagnosis"
     },
     {
      "field": "with_obesity",
      "format": ","
     },
     {
      "field": "total_separations",
      "format": ","
     },
     {
      "field": "pct_with_obesity",
      "title": "%"
     }
    ]
   }
  }
 ]
}