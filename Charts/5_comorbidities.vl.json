{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFontSize": 11,
   "titleFontSize": 12
  },
  "title": {
   "fontSize": 15,
   "anchor": "start"
  }
 },
 "title": "Top 20 principal diagnoses among hospital separations with obesity (U78.1) coded",
 "data": {
  "url": "5_comorbidities.csv",
  "format": {
   "type": "csv"
  }
 },
 "width": 480,
 "height": {
  "step": 20
 },
