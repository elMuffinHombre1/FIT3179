   "field": "diagnosis",
   "type": "nominal",
   "sort": "-x",
   "title": null,
   "axis": {
    "labelLimit": 340
   }
  },
  "x": {
   "field": "with_obesity",
   "type": "quantitative",
   "title": "Separations with U78.1 code"
  },
  "tooltip": [
   {
    "field": "code"
   },
   {
    "field": "diagnosis"
   },
   {
    "field": "with_obesity",
    "format": ",",
    "title": "With obesity"
   },
   {
    "field": "pct_of_obesity_separations",
    "title": "% of all U78.1 separations"
   }
  ]
 }
}