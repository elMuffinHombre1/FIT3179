{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFontSize": 11,
   "titleFontSize": 12
  },
  "title": {
   "fontSize": 15,
   "anchor": "start"
  }
 },
 "title": "Adult obesity by Population Health Area, 2022 (modelled ASR per 100)",
 "params": [
  {
   "name": "pick",
   "select": {
    "type": "point",
    "fields": [
     "Name"
    ],
    "on": "click"
   }
  }
 ],
 "hconcat": [
  {
   "width": 520,
   "height": 460,
   "data": {
    "url": "PHA_2021_Aust_GDA2020_Gen50.json",
    "format": {
     "type": "topojson",
     "feature": "PHA_2021_Aust_GDA2020_Gen50"
    }
   },
   "projection": {
    "type": "mercator"
   },
   "transform": [
    {
     "lookup": "properties.Code",
     "from": {
      "data": {
       "url": "phidu_obesity_clean.csv"
      },
      "key": "Code",
      "fields": [
       "Name",
       "State",
       "obese_asr",
       "obese_n"
      ]
     }
    }
   ],
   "mark": {
    "type": "geoshape",
    "stroke": "#fff",
    "strokeWidth": 0.1,
    "invalid": null
   },
   "encoding": {
    "color": {
     "condition": {
      "test": "!isValid(datum.obese_asr)",
      "value": "#e3e3e3"
     },
     "field": "obese_asr",
     "type": "quantitative",
     "title": "Obese ASR /100",
     "scale": {
      "scheme": "orangered",
      "domain": [
       10,
       45
      ],
      "clamp": true
     },
     "legend": {
      "orient": "bottom"
     }
    },
    "opacity": {
     "condition": {
      "param": "pick",
      "value": 1
     },
     "value": 0.85
    },
    "tooltip": [
     {
      "field": "Name",
      "title": "PHA"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_asr",
      "title": "ASR per 100"
     },
     {
      "field": "obese_n",
      "title": "Estimated number",
      "format": ","
     }
    ]
   }
  },
  {
   "width": 260,
   "height": {
    "step": 14
   },
   "data": {
    "url": "phidu_obesity_clean.csv"
   },
   "transform": [
    {
     "filter": "isValid(datum.obese_asr)"
    },
    {
     "window": [
      {
       "op": "rank",
       "as": "rank"
      }
     ],
     "sort": [
      {
       "field": "obese_asr",
       "order": "descending"
      }
     ]
    },
    {
     "filter": "datum.rank<=25"
    }
   ],
   "title": "Top 25 PHAs by obesity rate",
   "mark": {
    "type": "bar",
    "tooltip": true,
    "color": "#c0392b"
   },
   "encoding": {
    "y": {
     "field": "Name",
     "type": "nominal",
     "sort": "-x",
     "title": null,
     "axis": {
      "labelLimit": 220
     }
    },
    "x": {
     "field": "obese_asr",
     "type": "quantitative",
     "title": "ASR per 100"
    },
    "opacity": {
     "condition": {
      "param": "pick",
      "value": 1
     },
     "value": 0.6
    },
    "tooltip": [
     {
      "field": "Name"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_asr",
      "title": "ASR per 100"
     }
    ]
   }
  }
 ]
}