{
 "description": "Proportional symbol map: each Population Health Area is a circle sized by the estimated number of adults with obesity and coloured by the obesity rate.",
 "title": {
  "text": [
   "Most adults with obesity live along the east and",
   "south-east coasts"
  ],
  "subtitle": [
   "Circle size = estimated number of adults with obesity.",
   "Colour = obesity rate (% of adults), darker =",
   "higher."
  ]
 },
 "width": 540,
 "height": 450,
 "projection": {
  "type": "mercator"
 },
 "layer": [
  {
   "data": {
    "url": "PHA_2021_Aust_GDA2020_Gen50.json",
    "format": {
     "type": "topojson",
     "feature": "PHA_2021_Aust_GDA2020_Gen50"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#efefef",
    "stroke": "#d0d0d0",
    "strokeWidth": 0.2
   }
  },
  {
   "data": {
    "url": "phidu_obesity_symbols.csv",
    "format": {
     "type": "csv"
    }
   },
   "transform": [
    {
     "filter": "isValid(datum.obese_n) && isValid(datum.obese_asr)"
    }
   ],
   "mark": {
    "type": "circle",
    "opacity": 0.75,
    "stroke": "#333",
    "strokeWidth": 0.35,
    "tooltip": true
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "size": {
     "field": "obese_n",
     "type": "quantitative",
     "title": "Adults with obesity",
     "scale": {
      "type": "sqrt",
      "range": [
       2,
       260
      ],
      "domain": [
       0,
       22000
      ]
     },
     "legend": {
      "orient": "bottom-left",
      "format": ",.0f",
      "values": [
       2000,
       10000,
       20000
      ]
     }
    },
    "color": {
     "field": "obese_asr",
     "type": "quantitative",
     "title": "Obesity rate (%)",
     "scale": {
      "scheme": "viridis",
      "reverse": true,
      "domain": [
       10,
       55
      ],
      "clamp": true
     },
     "legend": {
      "orient": "top-right",
      "gradientLength": 150,
      "labelExpr": "datum.value + '%'"
     }
    },
    "order": {
     "field": "obese_n",
     "sort": "descending"
    },
    "tooltip": [
     {
      "field": "Name",
      "title": "Area"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_n",
      "title": "Estimated adults with obesity",
      "format": ",.0f"
     },
     {
      "field": "obese_asr",
      "title": "Obesity rate (%)",
      "format": ".1f"
     }
    ]
   }
  },
