{
 "description": "Proportional symbol map: each Population Health Area is a circle sized by the estimated number of adults with obesity and coloured by the obesity rate.",
 "title": {
  "text": [
   "Most adults with obesity live along the east and",
   "south-east coasts"
  ],
  "subtitle": [
   "Circle size = estimated number of adults with obesity.",
   "Colour = obesity rate (% of adults), darker =",
   "higher."
  ]
 },
 "width": 250,
 "height": 270,
 "projection": {
  "type": "mercator"
 },
 "layer": [
  {
   "data": {
    "url": "PHA_2021_Aust_GDA2020_Gen50.json",
    "format": {
     "type": "topojson",
     "feature": "PHA_2021_Aust_GDA2020_Gen50"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#EEF2F6",
    "stroke": "#CBD5E1",
    "strokeWidth": 0.2
   }
  },
  {
   "data": {
    "url": "phidu_obesity_symbols.csv",
    "format": {
     "type": "csv",
     "parse": {
      "obese_asr": "number",
      "obese_n": "number",
      "lon": "number",
      "lat": "number"
     }
    }
   },
   "transform": [
    {
     "filter": "isValid(datum.obese_n) && isValid(datum.obese_asr)"
    }
   ],
   "mark": {
    "type": "circle",
    "opacity": 0.75,
    "stroke": "#333",
    "strokeWidth": 0.35,
    "tooltip": true
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "size": {
     "field": "obese_n",
     "type": "quantitative",
     "title": "Adults with obesity",
     "scale": {
      "type": "sqrt",
      "range": [
       2,
       200
      ],
      "domain": [
       0,
       22000
      ]
     },
     "legend": {
      "orient": "bottom",
      "format": ",.0f",
      "values": [
       2000,
       10000,
       20000
      ],
      "direction": "horizontal",
      "columns": 3
     }
    },
    "color": {
     "field": "obese_asr",
     "type": "quantitative",
     "title": "Obesity rate (%)",
     "scale": {
      "domain": [
       10.0,
       19.0,
       28.0,
       37.0,
       46.0,
       55.0
      ],
      "clamp": true,
      "range": [
       "#E3EEF8",
       "#B7D3EA",
       "#7FB1D8",
       "#4A8CC2",
       "#1C63A0",
       "#0B3560"
      ]
     },
     "legend": {
      "orient": "top-right",
      "gradientLength": 160,
      "labelExpr": "datum.value + '%'"
     }
    },
    "order": {
     "field": "obese_n",
     "sort": "descending"
    },
    "tooltip": [
     {
      "field": "Name",
      "title": "Area"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_n",
      "title": "Estimated adults with obesity",
      "format": ",.0f"
     },
     {
      "field": "obese_asr",
      "title": "Obesity rate (%)",
      "format": ".1f"
     }
    ]
   }
  },
