{
 "description": "Choropleth map of modelled adult obesity rate by Population Health Area next to a ranked bar chart of the 25 highest areas.",
 "title": {
  "text": [
   "Adult obesity is highest in outer-suburban and regional areas"
  ],
  "subtitle": [
   "Modelled obesity rate (age-standardised, % of adults, 2022). Grey",
   "= no published estimate. Click a bar to highlight",
   "that area on the map."
  ]
 },
 "params": [
  {
   "name": "pick",
   "select": {
    "type": "point",
    "fields": [
     "Name"
    ],
    "on": "click"
   }
  }
 ],
 "hconcat": [
  {
   "width": 440,
   "height": 360,
   "data": {
    "url": "PHA_2021_Aust_GDA2020_Gen50.json",
    "format": {
     "type": "topojson",
     "feature": "PHA_2021_Aust_GDA2020_Gen50"
    }
   },
   "projection": {
    "type": "mercator"
   },
   "transform": [
    {
     "lookup": "properties.Code",
     "from": {
      "data": {
       "url": "phidu_obesity_clean.csv",
       "format": {
        "type": "csv",
        "parse": {
         "obese_asr": "number",
         "obese_n": "number"
        }
       }
      },
      "key": "Code",
      "fields": [
       "Name",
       "State",
       "obese_asr",
       "obese_n"
      ]
     }
    }
   ],
   "mark": {
    "type": "geoshape",
    "stroke": "#fff",
    "strokeWidth": 0.15,
    "invalid": null
   },
   "encoding": {
    "color": {
     "condition": {
      "test": "!isValid(datum.obese_asr)",
      "value": "#CBD5E1"
     },
     "field": "obese_asr",
     "type": "quantitative",
     "title": "Obese adults (%)",
     "scale": {
      "domain": [
       10.0,
       19.0,
       28.0,
       37.0,
       46.0,
       55.0
      ],
      "range": [
       "#E3EEF8",
       "#B7D3EA",
       "#7FB1D8",
       "#4A8CC2",
       "#1C63A0",
       "#0B3560"
      ],
      "clamp": true
     },
     "legend": {
      "orient": "bottom",
      "gradientLength": 240,
      "labelExpr": "datum.value + '%'"
     }
    },
    "opacity": {
     "condition": {
      "param": "pick",
      "value": 1
     },
     "value": 0.88
    },
    "tooltip": [
     {
      "field": "Name",
      "title": "Area"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_asr",
      "title": "Obesity rate (%)",
      "format": ".1f"
     },
     {
      "field": "obese_n",
      "title": "Estimated obese adults",
      "format": ","
     }
    ]
   }
  },
  {
   "width": 190,
   "height": {
    "step": 14
   },
   "data": {
    "url": "phidu_obesity_clean.csv",
    "format": {
     "type": "csv"
    }
   },
   "transform": [
    {
     "filter": "isValid(datum.obese_asr)"
    },
    {
     "window": [
      {
       "op": "rank",
       "as": "rank"
      }
     ],
     "sort": [
      {
       "field": "obese_asr",
       "order": "descending"
      }
     ]
    },
    {
     "filter": "datum.rank<=25"
    }
   ],
   "title": "25 highest areas",
   "mark": {
    "type": "bar",
    "color": "#1C63A0",
    "tooltip": true
   },
   "encoding": {
    "y": {
     "field": "Name",
     "type": "nominal",
     "sort": "-x",
     "title": null,
     "axis": {
      "labelLimit": 180
     }
    },
    "x": {
     "field": "obese_asr",
     "type": "quantitative",
     "title": "Adults who are obese (%)",
     "scale": {
      "domain": [
       0,
       70
      ],
      "zero": true
     },
     "axis": {
      "labelExpr": "datum.value + '%'",
      "values": [
       0,
       10,
       20,
       30,
       40,
       50,
       60
      ]
     }
    },
    "opacity": {
     "condition": {
      "param": "pick",
      "value": 1
     },
     "value": 0.55
    },
    "tooltip": [
     {
      "field": "Name",
      "title": "Area"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_asr",
      "title": "Obesity rate (%)",
      "format": ".1f"
     }
    ]
   }
  }
 ],
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "background": "#ffffff",
  "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "titleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "labelColor": "#334155",
   "titleColor": "#0F172A",
   "domainColor": "#94A3B8",
   "tickColor": "#94A3B8",
   "gridColor": "#E2E8F0",
   "titlePadding": 10,
   "labelPadding": 6
  },
  "axisX": {
   "grid": true
  },
  "axisY": {
   "grid": true
  },
  "legend": {
   "labelFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "titleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "labelColor": "#334155",
   "titleColor": "#0F172A",
   "titleLimit": 420,
   "symbolSize": 110
  },
  "header": {
   "labelFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "titleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "labelColor": "#0F172A",
   "titleColor": "#0F172A",
   "labelFontWeight": 600
  },
  "title": {
   "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "subtitleFont": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "fontSize": 16,
   "fontWeight": 700,
   "anchor": "start",
   "color": "#0F172A",
   "subtitleColor": "#64748B",
   "subtitleFontSize": 12,
   "subtitlePadding": 6
  },
  "text": {
   "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
   "color": "#0F172A"
  },
  "mark": {
   "font": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif"
  }
 }
}