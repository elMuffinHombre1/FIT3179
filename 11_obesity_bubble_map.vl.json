{
 "description": "Proportional symbol map: each Population Health Area is a circle sized by the estimated number of adults with obesity and coloured by the obesity rate.",
 "title": {
  "text": "Most adults with obesity live along the east and south-east coasts",
  "subtitle": "Circle size = estimated number of obese adults; colour = rate per 100 (darker = higher)."
 },
 "width": 720,
 "height": 560,
 "projection": {
  "type": "mercator"
 },
 "layer": [
  {
   "data": {
    "url": "PHA_2021_Aust_GDA2020_Gen50.json",
    "format": {
     "type": "topojson",
     "feature": "PHA_2021_Aust_GDA2020_Gen50"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#efefef",
    "stroke": "#d0d0d0",
    "strokeWidth": 0.2
   }
  },
  {
   "data": {
    "url": "phidu_obesity_symbols.csv",
    "format": {
     "type": "csv"
    }
   },
   "transform": [
    {
     "filter": "isValid(datum.obese_n) && isValid(datum.obese_asr)"
    }
   ],
   "mark": {
    "type": "circle",
    "opacity": 0.75,
    "stroke": "#333",
    "strokeWidth": 0.35,
    "tooltip": true
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "size": {
     "field": "obese_n",
     "type": "quantitative",
     "title": "Estimated obese adults",
     "scale": {
      "type": "sqrt",
      "range": [
       3,
       420
      ],
      "domain": [
       0,
       22000
      ]
     },
     "legend": {
      "orient": "bottom-left",
      "format": ",.0f",
      "values": [
       2000,
       10000,
       20000
      ]
     }
    },
    "color": {
     "field": "obese_asr",
     "type": "quantitative",
     "title": "Rate per 100",
     "scale": {
      "scheme": "viridis",
      "reverse": true,
      "domain": [
       10,
       55
      ],
      "clamp": true
     },
     "legend": {
      "orient": "bottom-right",
      "gradientLength": 160
     }
    },
    "order": {
     "field": "obese_n",
     "sort": "descending"
    },
    "tooltip": [
     {
      "field": "Name",
      "title": "PHA"
     },
     {
      "field": "State"
     },
     {
      "field": "obese_n",
      "title": "Estimated obese adults",
      "format": ",.0f"
     },
     {
      "field": "obese_asr",
      "title": "Rate per 100"
     }
    ]
   }
  }
 ],
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "background": "#fff",
  "view": {
   "stroke": null
  },
  "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "labelColor": "#222",
   "titleColor": "#222",
   "domainColor": "#666",
   "tickColor": "#666",
   "gridColor": "#e5e0d8"
  },
  "title": {
   "fontSize": 16,
   "anchor": "start",
   "color": "#2b2d42",
   "subtitleColor": "#666",
   "subtitleFontSize": 12,
   "font": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "header": {
   "labelColor": "#222",
   "titleColor": "#222",
   "labelFont": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "labelColor": "#222",
   "titleColor": "#222"
  },
  "text": {
   "color": "#222",
   "font": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  }
 }
}